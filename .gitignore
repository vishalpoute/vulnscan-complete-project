# ============================================================
# VulnScan Complete Project — .gitignore
# ============================================================

# ── SECRETS & CREDENTIALS (NEVER COMMIT THESE) ─────────────
.env
.env.local
.env.*.local
firebase_adminsdk.json
**/firebase_adminsdk.json
**/credentials.json
**/service_account*.json
**/api_key.txt
*.pem
*.key
*.p12
*.pfx

# ── PYTHON ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.Python
pip-wheel-metadata/
.installed.cfg
env/
venv/
ENV/
.venv
.env/

# ── FLUTTER / DART ──────────────────────────────────────────
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/pubspec.lock
# Keep pubspec.lock for reproducible builds - uncomment to ignore:
# pubspec.lock

# ── NODE / JAVASCRIPT ───────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDEs & EDITORS ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
.vs/

# ── OS GENERATED ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── LOGS & TEMP ─────────────────────────────────────────────
*.log
logs/
*.tmp
*.temp
.cache/
*.cache

# ── DOCKER ──────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ── MISC ────────────────────────────────────────────────────
*.bak
*.orig
